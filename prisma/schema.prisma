generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum RoleType {
  TEAM_LEAD
  TEAM_MEMBER
  REVIEWER
  ADMIN
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PLANNED
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  DELAYED
  COMPLETED
  BLOCKED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum BlockerPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockerStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  MITIGATING
  RESOLVED
  ACCEPTED
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
  REOPENED
}

enum TestStatus {
  NOT_TESTED
  PASS
  FAIL
  BLOCKED
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------------------------------
// AUTH, USERS, ROLES & PERMISSIONS
// ----------------------------------------------------

model User {
  id               String      @id @default(uuid())
  name             String
  email            String      @unique
  passwordHash     String
  role             RoleType    @default(TEAM_MEMBER)
  teamRole         String
  avatarUrl        String?
  phone            String?
  githubUsername   String?
  responsibilities String?     @db.Text
  isActive         Boolean     @default(true)
  isDeleted        Boolean     @default(false)
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relationships
  userRoles           UserRole[]
  projectMembers      ProjectMember[]
  assignedTasks       Task[]            @relation("TaskAssignee")
  reportedTasks       Task[]            @relation("TaskReporter")
  reviewedTasks       Task[]            @relation("TaskReviewer")
  comments            TaskComment[]
  reportedBlockers    Blocker[]         @relation("BlockerReporter")
  blockedByBlockers   Blocker[]         @relation("BlockerBlockedUser")
  activities          Activity[]
  authoredDocuments   Document[]        @relation("DocumentAuthor")
  reviewedDocuments   Document[]        @relation("DocumentReviewer")
  reportedBugs        Bug[]             @relation("BugReporter")
  assignedBugs        Bug[]             @relation("BugAssignee")
  executedTestCases   TestCase[]        @relation("TestCaseTester")
  testRuns            TestRun[]
  notifications       Notification[]
  meetingParticipants MeetingParticipant[]
  ownedWorkstreams    Workstream[]      @relation("WorkstreamOwner")
  ownedMilestones     Milestone[]       @relation("MilestoneOwner")
  ownedRisks          Risk[]            @relation("RiskOwner")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------
// PROJECTS & MEMBERS
// ----------------------------------------------------

model Project {
  id                     String         @id @default(uuid())
  projectId              String         @unique @default("proj-acadshield-001")
  name                   String
  sihProblemStatement    String         @db.Text
  problemStatementNumber String?        @default("1422")
  description            String         @db.Text
  objective              String         @db.Text
  startDate              DateTime       @default(now())
  targetCompletionDate   DateTime
  currentPhase           String         @default("Phase 2 - Core Integration")
  status                 ProjectStatus  @default(ACTIVE)
  progress               Int            @default(0)
  repositoryUrl          String
  demoUrl                String?
  deploymentUrl          String?
  isDeleted              Boolean        @default(false)
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Relationships
  members             ProjectMember[]
  workstreams         Workstream[]
  milestones          Milestone[]
  sprints             Sprint[]
  tasks               Task[]
  blockers            Blocker[]
  activities          Activity[]
  meetings            Meeting[]
  documents           Document[]
  risks               Risk[]
  bugs                Bug[]
  testCases           TestCase[]
  testRuns            TestRun[]
  githubRepositories  GitHubRepository[]
  readinessItems      ReadinessItem[]
  demoChecklistItems  DemoChecklistItem[]
  settings            Setting[]

  @@index([projectId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id               String   @id @default(uuid())
  projectId        String
  userId           String
  roleInProject    String
  responsibilities String?  @db.Text
  isLead           Boolean  @default(false)
  joinedAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ----------------------------------------------------
// WORKSTREAMS
// ----------------------------------------------------

model Workstream {
  id          String   @id @default(uuid())
  projectId   String
  code        String
  name        String
  description String   @db.Text
  ownerId     String?
  status      String   @default("ACTIVE")
  progress    Int      @default(0)
  deadline    DateTime?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("WorkstreamOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([projectId])
  @@index([code])
  @@map("workstreams")
}

// ----------------------------------------------------
// TASKS, SUBTASKS, DEPENDENCIES & COMMENTS
// ----------------------------------------------------

model Task {
  id                String       @id @default(uuid())
  taskId            String       @unique
  projectId         String
  workstreamId      String?
  milestoneId       String?
  sprintId          String?
  title             String
  description       String       @db.Text
  assigneeId        String?
  reporterId        String?
  reviewerId        String?
  priority          TaskPriority @default(HIGH)
  status            TaskStatus   @default(TODO)
  startDate         DateTime?
  dueDate           DateTime?
  estimatedHours    Float        @default(8.0)
  actualHours       Float        @default(0.0)
  progress          Int          @default(0)
  dependencies      String?      @db.Text
  labels            String?
  githubIssueNumber Int?
  githubPrNumber    Int?
  githubBranch      String?
  reviewStatus      String?      @default("PENDING")
  reviewComments    String?      @db.Text
  isDeleted         Boolean      @default(false)
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  milestone  Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  sprint     Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter   User?       @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewer   User?       @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  subtasks       Subtask[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  blockers       Blocker[]
  milestoneTasks MilestoneTask[]
  sprintTasks    SprintTask[]
  dependenciesOn TaskDependency[] @relation("TaskDependent")
  dependentTasks TaskDependency[] @relation("TaskPrerequisite")

  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@map("tasks")
}

model Subtask {
  id          String    @id @default(uuid())
  taskId      String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model TaskDependency {
  id             String @id @default(uuid())
  taskId         String
  prerequisiteId String

  task         Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisite Task @relation("TaskPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([taskId, prerequisiteId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  fileType  String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

// ----------------------------------------------------
// MILESTONES & SPRINTS
// ----------------------------------------------------

model Milestone {
  id            String          @id @default(uuid())
  milestoneCode String
  projectId     String
  name          String
  description   String          @db.Text
  deadline      DateTime?
  startDate     DateTime        @default(now())
  endDate       DateTime
  ownerId       String?
  progress      Int             @default(0)
  status        MilestoneStatus @default(PLANNED)
  risks         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?           @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks   Task[]
  milestoneTasks MilestoneTask[]

  @@unique([projectId, milestoneCode])
  @@index([projectId])
  @@map("milestones")
}

model MilestoneTask {
  id          String   @id @default(uuid())
  milestoneId String
  taskId      String
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, taskId])
  @@map("milestone_tasks")
}

model Sprint {
  id           String       @id @default(uuid())
  projectId    String
  number       Int
  name         String
  goal         String       @db.Text
  startDate    DateTime
  endDate      DateTime
  status       SprintStatus @default(PLANNED)
  progress     Int          @default(0)
  velocity     Int          @default(0)
  burndownData String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  sprintTasks SprintTask[]

  @@unique([projectId, number])
  @@index([projectId])
  @@map("sprints")
}

model SprintTask {
  id        String   @id @default(uuid())
  sprintId  String
  taskId    String
  createdAt DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sprintId, taskId])
  @@map("sprint_tasks")
}

// ----------------------------------------------------
// BLOCKERS & ACTIVITIES
// ----------------------------------------------------

model Blocker {
  id                  String          @id @default(uuid())
  blockerId           String          @unique
  projectId           String
  taskId              String?
  title               String
  description         String          @db.Text
  impact              String?         @db.Text
  reportedById        String
  blockingUserId      String?
  blockedUserId       String?
  priority            BlockerPriority @default(HIGH)
  status              BlockerStatus   @default(OPEN)
  expectedResolution DateTime?
  resolutionNotes     String?         @db.Text
  resolvedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reporter     User    @relation("BlockerReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  blockedUser  User?   @relation("BlockerBlockedUser", fields: [blockedUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("blockers")
}

model Activity {
  id         String   @id @default(uuid())
  projectId  String
  userId     String?
  eventType  String
  entityType String
  entityId   String?
  summary    String   @db.Text
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdAt])
  @@map("activities")
}

// ----------------------------------------------------
// MEETINGS & ACTION ITEMS
// ----------------------------------------------------

model Meeting {
  id              String   @id @default(uuid())
  projectId       String
  title           String
  type            String   @default("DAILY_STANDUP")
  scheduledAt     DateTime @default(now())
  durationMinutes Int      @default(30)
  agenda          String   @db.Text
  notes           String?  @db.Text
  decisions       String?  @db.Text
  meetingLink     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  actionItems  MeetingActionItem[]

  @@index([projectId])
  @@map("meetings")
}

model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  attended  Boolean  @default(true)
  joinedAt  DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_participants")
}

model MeetingActionItem {
  id                String    @id @default(uuid())
  meetingId         String
  title             String
  assigneeId        String?
  dueDate           DateTime?
  isCompleted       Boolean   @default(false)
  isConverted       Boolean   @default(false)
  convertedToTaskId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_action_items")
}

// ----------------------------------------------------
// DOCUMENTS, RISKS & BUGS
// ----------------------------------------------------

model Document {
  id           String               @id @default(uuid())
  projectId    String
  title        String
  type         String               @default("SRS")
  category     String               @default("SPECIFICATION")
  version      String               @default("1.0.0")
  content      String?              @db.Text
  fileUrl      String?
  fileSize     Int?                 @default(0)
  ownerId      String
  reviewerId   String?
  reviewStatus DocumentReviewStatus @default(PENDING)
  reviewNotes  String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User    @relation("DocumentAuthor", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("documents")
}

model Risk {
  id             String          @id @default(uuid())
  projectId      String
  title          String
  description    String?         @db.Text
  category       String          @default("TECHNICAL")
  likelihood     RiskProbability @default(MEDIUM)
  impact         RiskImpact      @default(HIGH)
  mitigationPlan String          @db.Text
  status         RiskStatus      @default(IDENTIFIED)
  ownerId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("risks")
}

model Bug {
  id               String      @id @default(uuid())
  bugId            String      @unique
  projectId        String
  title            String
  description      String      @db.Text
  severity         BugSeverity @default(HIGH)
  priority         BugPriority @default(HIGH)
  status           BugStatus   @default(OPEN)
  stepsToReproduce String?     @db.Text
  expectedResult   String?     @db.Text
  actualResult     String?     @db.Text
  reporterId       String
  assigneeId       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter User    @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User?   @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("bugs")
}

// ----------------------------------------------------
// TESTING & QA
// ----------------------------------------------------

model TestCase {
  id              String     @id @default(uuid())
  testCaseId      String     @unique
  projectId       String
  code            String?
  feature         String
  description     String     @db.Text
  steps           String     @db.Text
  expectedResult  String     @db.Text
  actualResult    String?    @db.Text
  status          TestStatus @default(NOT_TESTED)
  executionTimeMs Int?       @default(45)
  testerId        String?
  lastRunAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tester   User?     @relation("TestCaseTester", fields: [testerId], references: [id], onDelete: SetNull)
  testRuns TestRun[]

  @@index([projectId])
  @@index([status])
  @@map("test_cases")
}

model TestRun {
  id          String     @id @default(uuid())
  projectId   String
  testCaseId  String
  runByUserId String
  status      TestStatus
  outputLogs  String?    @db.Text
  durationMs  Int
  createdAt   DateTime   @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  runByUser User    @relation(fields: [runByUserId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([testCaseId])
  @@map("test_runs")
}

// ----------------------------------------------------
// GITHUB INTEGRATION
// ----------------------------------------------------

model GitHubRepository {
  id          String   @id @default(uuid())
  projectId   String
  repoOwner   String   @default("vishanth11")
  repoName    String   @default("AcadShield")
  repoUrl     String   @default("https://github.com/vishanth11/AcadShield.git")
  isPrivate   Boolean  @default(false)
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits      GitHubCommit[]
  pullRequests GitHubPullRequest[]
  issues       GitHubIssue[]

  @@unique([projectId, repoOwner, repoName])
  @@map("github_repositories")
}

model GitHubCommit {
  id           String   @id @default(uuid())
  repositoryId String
  sha          String   @unique
  message      String   @db.Text
  authorName   String
  authorEmail  String
  branch       String   @default("main")
  committedAt  DateTime
  url          String
  stats        String?

  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([sha])
  @@map("github_commits")
}

model GitHubPullRequest {
  id           String         @id @default(uuid())
  repositoryId String
  prNumber     Int
  title        String
  body         String?        @db.Text
  status       String         @default("OPEN")
  authorName   String
  headBranch   String
  baseBranch   String
  url          String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews    GitHubReview[]

  @@unique([repositoryId, prNumber])
  @@index([repositoryId])
  @@map("github_pull_requests")
}

model GitHubReview {
  id            String   @id @default(uuid())
  pullRequestId String
  reviewerName  String
  status        String   @default("APPROVED")
  comment       String?  @db.Text
  submittedAt   DateTime @default(now())

  pullRequest GitHubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@map("github_reviews")
}

model GitHubIssue {
  id           String   @id @default(uuid())
  repositoryId String
  issueNumber  Int
  title        String
  body         String?  @db.Text
  state        String   @default("OPEN")
  authorName   String
  url          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, issueNumber])
  @@index([repositoryId])
  @@map("github_issues")
}

// ----------------------------------------------------
// NOTIFICATIONS, READINESS & SETTINGS
// ----------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ReadinessItem {
  id             String   @id @default(uuid())
  projectId      String
  category       String
  categoryNumber Int      @default(1)
  name           String
  description    String   @db.Text
  weight         Int      @default(10)
  progress       Int      @default(0)
  status         String   @default("IN_PROGRESS")
  evidence       String?  @db.Text
  gaps           String?  @db.Text
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("readiness_items")
}

model DemoChecklistItem {
  id             String   @id @default(uuid())
  projectId      String
  stepNumber     Int      @default(1)
  category       String   @default("CORE_DEMO")
  itemCode       String
  title          String
  description    String   @db.Text
  expectedResult String?  @db.Text
  status         String   @default("NOT_TESTED")
  evidence       String?  @db.Text
  orderIndex     Int      @default(0)
  lastTestedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("demo_checklist_items")
}

model Setting {
  id          String   @id @default(uuid())
  projectId   String
  key         String
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("settings")
}
