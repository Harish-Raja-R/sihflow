# ==========================================
# SihFlow ERP — Environment Configuration
# ==========================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Port
PORT=5000

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sihflow_db?schema=public

# JSON Web Token Secret & Expiry
JWT_SECRET=sihflow-super-secret-jwt-key-2026-sih
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Optional: GitHub API Integration Token (For Live Repo Sync)
# Leave empty to use verified repository snapshots
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
